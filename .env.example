# ---- Supabase (free database) ----
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SERVICE ROLE key (server-side only, keep secret). Settings -> API -> service_role.
SUPABASE_SERVICE_KEY=your-service-role-key

# ---- football-data.org (free match data) ----
# Register free at https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=your-football-data-api-key

# Comma-separated competition codes to track (free tier supports these):
# PL=Premier League, PD=La Liga, SA=Serie A, BL1=Bundesliga, FL1=Ligue 1,
# CL=Champions League, DED=Eredivisie, PPL=Primeira Liga, ELC=Championship,
# BSA=Brazil Serie A, WC=World Cup, EC=Euros
TRACKED_COMPETITIONS=PL,PD,SA,BL1,FL1,CL

# ---- Sync job security ----
# A long random secret. The hourly job must send this to call /api/sync.
SYNC_SECRET=change-me-to-a-long-random-string

# ---- App ----
# Used to build the shareable link shown in the UI (your deployed URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
